{%- comment -%}
  Spec rows for RO metaobjects. Field handles match Shopify Admin keys
  generated from the field names (lowercase, non-alphanumerics → underscore).
{%- endcomment -%}
{%- if family == 'slim_commercial_ro' -%}
  {%- render 'lago-spec-dl-row', label: 'Item No.', value: specs.item_no -%}
  {%- render 'lago-spec-dl-row', label: 'Power', value: specs.power -%}
  {%- render 'lago-spec-dl-row', label: 'Flow Rate*', value: specs.flow_rate -%}
  {%- render 'lago-spec-dl-row', label: 'Power Consumption', value: specs.power_consumption -%}
  {%- render 'lago-spec-dl-row', label: 'Weight (System/Crate)', value: specs.weight_system_crate -%}
  {%- render 'lago-spec-dl-row', label: 'System Dimensions', value: specs.system_dimensions -%}
  {%- render 'lago-spec-dl-row', label: 'Crate Dimensions', value: specs.crate_dimensions -%}
  {%- render 'lago-spec-dl-row', label: 'Pallet Qty.', value: specs.pallet_qty -%}
{%- elsif family == 'skid_mounted_ro' -%}
  {%- render 'lago-spec-dl-row', label: 'Item No.', value: specs.item_no -%}
  {%- render 'lago-spec-dl-row', label: 'RO Flow Rate*', value: specs.ro_flow_rate -%}
  {%- render 'lago-spec-dl-row', label: 'Electrical Parameters', value: specs.electrical_parameters -%}
  {%- render 'lago-spec-dl-row', label: 'Weight (System / In Crate)', value: specs.weight_system_in_crate -%}
  {%- render 'lago-spec-dl-row', label: 'System Dimensions', value: specs.system_dimensions -%}
  {%- render 'lago-spec-dl-row', label: 'Water Tank Dimensions', value: specs.water_tank_dimensions -%}
  {%- render 'lago-spec-dl-row', label: 'Crate Dimensions', value: specs.crate_dimensions -%}
{%- elsif family == 'industrial_ro' -%}
  {%- render 'lago-spec-dl-row', label: 'Item No.', value: specs.item_no -%}
  {%- render 'lago-spec-dl-row', label: 'Product Name', value: specs.product_name -%}
  {%- render 'lago-spec-dl-row', label: 'Daily Capacity*', value: specs.daily_capacity -%}
  {%- render 'lago-spec-dl-row', label: 'Flow Rate*', value: specs.flow_rate -%}
  {%- render 'lago-spec-dl-row', label: 'Membranes', value: specs.membranes -%}
  {%- render 'lago-spec-dl-row', label: 'Dimensions (W x D x H)', value: specs.dimensions_w_x_d_x_h -%}
  {%- render 'lago-spec-dl-row', label: 'Weight', value: specs.weight -%}
{%- endif -%}
