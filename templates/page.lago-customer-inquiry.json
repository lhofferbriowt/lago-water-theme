      "settings": {
        "custom_liquid": "<style>\n  .web-to-lead-form {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n  .web-to-lead-form__notice {\n    margin-bottom: 1.5rem;\n  }\n\n  .web-to-lead-form__fields {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 1rem;\n  }\n\n  .web-to-lead-form label,\n  .web-to-lead-form .field-label {\n    display: block;\n    margin-bottom: 6px;\n    font-weight: 600;\n  }\n\n  .web-to-lead-form input[type=\"text\"],\n  .web-to-lead-form input[type=\"email\"],\n  .web-to-lead-form input[type=\"tel\"],\n  .web-to-lead-form select,\n  .web-to-lead-form textarea {\n    width: 100%;\n    padding: 8px;\n    box-sizing: border-box;\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    border-radius: 4px;\n  }\n\n  .web-to-lead-form textarea {\n    min-height: 6rem;\n    resize: vertical;\n  }\n\n  .web-to-lead-form .checkbox-group label {\n    display: block;\n    margin-bottom: 6px;\n    font-weight: 400;\n  }\n\n  .web-to-lead-form .required {\n    color: #d32f2f;\n    font-weight: bold;\n  }\n\n  .web-to-lead-form__submit {\n    margin-top: 0.5rem;\n  }\n\n  .web-to-lead-form .submit-button {\n    padding: 16px 32px;\n    background: #4a71aa;\n    color: #fff;\n    font-size: 16px;\n    border: none;\n    border-radius: 9999px;\n    cursor: pointer;\n  }\n\n  .web-to-lead-form .submit-button:hover {\n    opacity: 0.92;\n  }\n\n  @media screen and (min-width: 750px) {\n    .web-to-lead-form__fields {\n      grid-template-columns: repeat(2, 1fr);\n      column-gap: 2rem;\n      row-gap: 1rem;\n    }\n\n    .web-to-lead-form .form-row--full {\n      grid-column: 1 / -1;\n    }\n  }\n</style>\n\n<div class=\"page-width\">\n<script>\n  window.WEB_TO_LEAD_UTM_SOURCE = window.WEB_TO_LEAD_UTM_SOURCE || '';\n</script>\n\n<form id=\"webToLeadForm\" class=\"web-to-lead-form\" action=\"https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8&orgId=00D5f000006QMSU\" method=\"POST\">\n\n  <p class=\"web-to-lead-form__notice\"><span class=\"required\">*</span> Required Fields</p>\n\n  <input type=\"hidden\" name=\"oid\" value=\"00D5f000006QMSU\">\n  <input type=\"hidden\" name=\"retURL\" value=\"https://lagowater.com/pages/thank-you\">\n  <input type=\"hidden\" id=\"campaign_id\" name=\"campaign_id\" value=\"701VU00000uVNhe\">\n  <input type=\"hidden\" id=\"Campaign_ID\" name=\"Campaign_ID\" value=\"701VU00000uVNhe\">\n  <input type=\"hidden\" name=\"lead_source\" value=\"Web\">\n  <input type=\"hidden\" id=\"00NVU00000683YL\" name=\"00NVU00000683YL\" value=\"\">\n\n\n  <div class=\"web-to-lead-form__fields\">\n\n    <div class=\"form-row\">\n      <label for=\"first_name\">First Name <span class=\"required\">*</span></label>\n      <input id=\"first_name\" maxlength=\"40\" name=\"first_name\" size=\"20\" type=\"text\" required>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"last_name\">Last Name <span class=\"required\">*</span></label>\n      <input id=\"last_name\" maxlength=\"80\" name=\"last_name\" size=\"20\" type=\"text\" required>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"phone\">Phone <span class=\"required\">*</span></label>\n      <input id=\"phone\" maxlength=\"40\" name=\"phone\" size=\"20\" type=\"tel\" required>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"email\">Email <span class=\"required\">*</span></label>\n      <input id=\"email\" maxlength=\"80\" name=\"email\" size=\"20\" type=\"email\" required>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"00NVU0000068wL7\">Location Type <span class=\"required\">*</span></label>\n      <select id=\"00NVU0000068wL7\" name=\"00NVU0000068wL7\" title=\"Location Type\" required>\n        <option value=\"\" selected disabled>What type of location is this for?</option>\n        <option value=\"Home / Residential\">Home / Residential</option>\n        <option value=\"Office / Workspace\">Office / Workspace</option>\n        <option value=\"Retail / Hospitality\">Retail / Hospitality</option>\n        <option value=\"Industrial / Warehouse\">Industrial / Warehouse</option>\n        <option value=\"Other (Please Specify)\">Other (Please Specify)</option>\n      </select>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"00NVU0000068vor\">Number of Locations <span class=\"required\">*</span></label>\n      <select id=\"00NVU0000068vor\" name=\"00NVU0000068vor\" title=\"# Of Business Locations\" required>\n        <option value=\"\" selected disabled>How many locations are you inquiring for?</option>\n        <option value=\"1\">1</option>\n        <option value=\"2-9\">2-9</option>\n        <option value=\"10+\">10+</option>\n      </select>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"00NVU0000068wPx\">Number of People <span class=\"required\">*</span></label>\n      <select id=\"00NVU0000068wPx\" name=\"00NVU0000068wPx\" title=\"# Of People\" required>\n        <option value=\"\" selected disabled>How many people will be regularly using this system?</option>\n        <option value=\"Just Me\">Just Me</option>\n        <option value=\"2-5 People\">2-5 People</option>\n        <option value=\"6-20 People\">6-20 People</option>\n        <option value=\"21-50 People\">21-50 People</option>\n      </select>\n    </div>\n\n    <div class=\"form-row\">\n      <label for=\"00NVU0000068wUn\">Current Set Up <span class=\"required\">*</span></label>\n      <select id=\"00NVU0000068wUn\" name=\"00NVU0000068wUn\" title=\"Current Set Up\" required>\n        <option value=\"\" selected disabled>Do you currently have an ice or water system?</option>\n        <option value=\"Yes\">Yes</option>\n        <option value=\"No\">No</option>\n        <option value=\"Just Researching Options\">Just Researching Options</option>\n      </select>\n    </div>\n\n    <div class=\"form-row form-row--full checkbox-group\">\n      <span class=\"field-label\">What Features are you most interested in? <span class=\"required\">*</span></span>\n      <label><input type=\"checkbox\" name=\"Interested_In_Features_Checkbox\" value=\"Cold Water\"> Cold Water</label>\n      <label><input type=\"checkbox\" name=\"Interested_In_Features_Checkbox\" value=\"Hot Water\"> Hot Water</label>\n      <label><input type=\"checkbox\" name=\"Interested_In_Features_Checkbox\" value=\"Filtered Water\"> Filtered Water</label>\n      <label><input type=\"checkbox\" name=\"Interested_In_Features_Checkbox\" value=\"Sparkling Water\"> Sparkling Water</label>\n      <label><input type=\"checkbox\" name=\"Interested_In_Features_Checkbox\" value=\"Crushed Ice\"> Crushed Ice</label>\n      <label><input type=\"checkbox\" name=\"Interested_In_Features_Checkbox\" value=\"Cube Ice\"> Cube Ice</label>\n    </div>\n    <input type=\"hidden\" id=\"00NVU0000068wTB\" name=\"00NVU0000068wTB\">\n\n    <div class=\"form-row form-row--full checkbox-group\">\n      <span class=\"field-label\">What matters most to you when choosing a system? <span class=\"required\">*</span></span>\n      <label><input type=\"checkbox\" name=\"What_Matters_Most_Checkbox\" value=\"Taste\"> Taste</label>\n      <label><input type=\"checkbox\" name=\"What_Matters_Most_Checkbox\" value=\"Compact Size\"> Compact Size</label>\n      <label><input type=\"checkbox\" name=\"What_Matters_Most_Checkbox\" value=\"Eco-Friendly (Bottle Free)\"> Eco-Friendly (Bottle Free)</label>\n      <label><input type=\"checkbox\" name=\"What_Matters_Most_Checkbox\" value=\"Advanced Filtration\"> Advanced Filtration</label>\n      <label><input type=\"checkbox\" name=\"What_Matters_Most_Checkbox\" value=\"Affordable Pricing\"> Affordable Pricing</label>\n      <label><input type=\"checkbox\" name=\"What_Matters_Most_Checkbox\" value=\"Maintenance & Service Support\"> Maintenance &amp; Service Support</label>\n    </div>\n    <input type=\"hidden\" id=\"00NVU0000068wZd\" name=\"00NVU0000068wZd\">\n\n    <div class=\"form-row\">\n      <label for=\"00N5f00000fy7U2\">Timeline <span class=\"required\">*</span></label>\n      <select id=\"00N5f00000fy7U2\" name=\"00N5f00000fy7U2\" title=\"Timeline\" required>\n        <option value=\"\" selected disabled>When are you looking to install or switch?</option>\n        <option value=\"ASAP\">ASAP</option>\n        <option value=\"1 month\">1 month</option>\n        <option value=\"1-3 months\">1-3 months</option>\n        <option value=\"Just Browsing\">Just Browsing</option>\n      </select>\n    </div>\n\n    <div class=\"form-row form-row--full\">\n      <label for=\"description\">Additional Notes (Optional)</label>\n      <textarea id=\"description\" name=\"description\"></textarea>\n    </div>\n\n    <div class=\"form-row form-row--full web-to-lead-form__submit\">\n      <input class=\"submit-button\" type=\"submit\" name=\"submit\" value=\"Submit\">\n    </div>\n\n  </div>\n</form>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const form = document.getElementById('webToLeadForm');\n    if (!form) return;\n\n    form.addEventListener('submit', function (event) {\n      const selectedFeatures = Array.from(\n        document.querySelectorAll('input[name=\"Interested_In_Features_Checkbox\"]:checked')\n      ).map(function (cb) { return cb.value; });\n\n      if (selectedFeatures.length === 0) {\n        alert('Please select at least one Interested In Feature.');\n        event.preventDefault();\n        return;\n      }\n\n      document.getElementById('00NVU0000068wTB').value = selectedFeatures.join(';');\n\n      const selectedMattersMost = Array.from(\n        document.querySelectorAll('input[name=\"What_Matters_Most_Checkbox\"]:checked')\n      ).map(function (cb) { return cb.value; });\n\n      if (selectedMattersMost.length === 0) {\n        alert('Please select at least one What Matters Most option.');\n        event.preventDefault();\n        return;\n      }\n\n      document.getElementById('00NVU0000068wZd').value = selectedMattersMost.join(';');\n\n      const utmField = document.getElementById('00NVU00000683YL');\n      if (utmField && window.WEB_TO_LEAD_UTM_SOURCE) {\n        utmField.value = window.WEB_TO_LEAD_UTM_SOURCE;\n      }\n    });\n  });\n</script>\n</div>",
